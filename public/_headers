# Widgets are active content — inline scripts that run inside someone else's
# client — and were shipping from this origin with no security headers at all:
# no CSP, no nosniff, no HSTS, no referrer policy. Confirmed against production.
#
# The MCP delivery path inlines these documents and the host applies its own
# sandbox CSP, so this covers the directly-served copies: the gallery, previews,
# and anything a host fetches by URL.
#
# Deliberately no X-Frame-Options or frame-ancestors. The consent page denies
# framing outright because nothing should ever embed it; a widget's whole job is
# to be embedded, and the set of hosts that do it (ChatGPT, Claude, Cursor,
# Zed, VS Code, Windsurf, …) is not one this file can enumerate without
# breaking whichever one it forgets. These documents carry no credential and no
# user data on their own — they render from the payload the host passes in.
/widgets/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'none'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff

# Agent headshots for <ox-avatar> photo mode (scripts/generate-agent-photos.mjs).
# Names are not content-hashed, so cache for a day and revalidate in the background.
/avatars/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff

/consent.html
  Cache-Control: no-store, no-transform
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
