{
  "name": "orgx-mcp-worker",
  "version": "1.1.0",
  "private": true,
  "homepage": "https://mcp.useorgx.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/useorgx/orgx-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/useorgx/orgx-mcp/issues"
  },
  "type": "module",
  "scripts": {
    "build:sdk": "node scripts/build-mcp-sdk.js",
    "build": "pnpm build:sdk",
    "dev": "wrangler dev --port 8787",
    "deploy": "pnpm build && wrangler deploy",
    "og:render": "node scripts/render-social-preview.mjs",
    "widget:version": "node scripts/generate-widget-build-info.mjs",
    "widget:build": "node scripts/build-widgets.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "precommit:og": "node scripts/precommit-og-render.mjs",
    "prebuild": "pnpm widget:build && pnpm widget:version",
    "predev": "pnpm widget:build && pnpm widget:version",
    "pretype-check": "pnpm widget:build && pnpm widget:version",
    "pretest": "pnpm widget:build && pnpm widget:version",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:openai-review": "vitest run tests/openaiSubmissionReadiness.spec.ts",
    "test:mcp-contract": "vitest run tests/promptTemplatePolicy.spec.ts tests/securityHeaders.spec.ts tests/mcpTransport.spec.ts tests/mcp.sessionStorage.spec.ts tests/mcpLifecycleActionAliases.spec.ts tests/reporting.mcp-tools.spec.ts tests/operatorChronicleFallback.spec.ts tests/mcpWorker.toolRegistration.spec.ts tests/mcpWorker.contextAccessTier.spec.ts tests/mcpWorker.edgeRateLimit.spec.ts tests/mcpWorker.entityActionAttach.spec.ts tests/mcpWorker.entityActionShipBatch.spec.ts tests/mcpWorker.taskContextHydrator.spec.ts tests/mcpWorker.toolAccessGating.spec.ts tests/mcpWorker.accountTools.spec.ts tests/planSessionContract.spec.ts tests/schemaIntrospection.spec.ts tests/contractTools.spec.ts tests/listEntitiesWorkspaceScope.spec.ts tests/loopReliabilityValidation.spec.ts tests/artifactContracts.spec.ts tests/founderTeamArtifactCatalog.spec.ts tests/toolCoverageMatrix.spec.ts",
    "benchmark:mcp": "node scripts/benchmark-mcp-performance.mjs",
    "verify": "pnpm type-check && pnpm test:mcp-contract && pnpm build",
    "directory:preflight": "node scripts/directory-preflight.mjs",
    "registry:keys": "./scripts/generate-registry-keys.sh",
    "registry:validate": "./scripts/publish-to-registry.sh --dry-run",
    "registry:publish": "./scripts/publish-to-registry.sh",
    "smoke:endpoints": "./scripts/smoke-endpoints.sh",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "catalog:generate": "tsx scripts/generate-tool-catalog.ts",
    "catalog:sync:monorepo": "TOOL_CATALOG_EXTRA_OUT=${ORGX_MONOREPO_DIR:-../orgx}/orgx/docs/mintlify/generated/tool-catalog.json tsx scripts/generate-tool-catalog.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.2.4",
    "@modelcontextprotocol/ext-apps": "1.1.2",
    "@modelcontextprotocol/sdk": "1.26.0",
    "agents": "0.7.2",
    "zod": "^3.25.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260103.0",
    "tsx": "^4.22.5",
    "typescript": "^5.6.3",
    "vite": "^6.3.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.54.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
